DJANGO_SUPERUSER_USERNAME=admin
# Required. The production entrypoint (backend.entrypoint.prod.sh) refuses to
# boot if this is empty, so it cannot ship a usable default here. Pick your
# own value; do not copy an example from this file into a real deployment.
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@example.com

# Required. Generate your own; a value copied from this template is public
# (it is committed to a public repo) and gives anyone who reads this file the
# ability to forge signed sessions and tokens. Generate one with either:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#   openssl rand -hex 48
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=db
DB_PORT=5432

REDIS_HOST=redis
REDIS_LOCATION=redis://redis:6379/1
REDIS_PORT=6379
REDIS_DB=0

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email_user
EMAIL_HOST_PASSWORD=your_email_user_password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=default_from_email

# Cross-origin frontend (added, do not remove the template defaults above).
# CORS_ALLOWED_ORIGINS: origins allowed to call the API with credentials.
# FRONTEND_BASE_URL: where activation / password-reset email links point.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
FRONTEND_BASE_URL=http://127.0.0.1:5500

# Optional. x264 preset used when transcoding uploads to HLS; defaults to
# "veryfast". On a small VM set "ultrafast" to roughly halve the transcode
# time, at the cost of slightly larger segment files.
# FFMPEG_PRESET=ultrafast

# --- Deployment (production stack only) -------------------------------------
# SITE_ADDRESS is REQUIRED by compose.prod.yml: your domain or an <ip>.sslip.io
# host. Caddy uses it to request the TLS certificate and to match the site
# block, so the stack refuses to start without it.
SITE_ADDRESS=videoflix.example.com

# Trusted reverse proxies in front of Django, used to pick the real client IP
# out of X-Forwarded-For for rate limiting. 1 = Caddy only (the default prod
# topology). Raise it if you put a CDN in front of Caddy; a value that is too
# low makes the limits keyable by a forged header.
NUM_PROXIES=1

# Application log level on stdout (Docker captures it). DEBUG is very chatty.
LOG_LEVEL=INFO

# Optional hardening overrides. Both default from DEBUG, so you only set them
# to deviate: SECURE_SSL_REDIRECT defaults to True when DEBUG=False, and HSTS
# stays off until you are sure the domain will keep serving HTTPS (the header
# is hard to walk back - browsers cache it for the full max-age).
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
